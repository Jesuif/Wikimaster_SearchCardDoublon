{
  "manifest_version": 3,
  "name": "WikiMasters Doublons",
  "version": "1.3",
  "description": "Doublons, cartes animées et manquantes, statistiques et échanges sur WikiMasters. Compte tes paquets et te prévient.",
  "icons": { "128": "icone-128.png" },
  "permissions": ["storage", "alarms", "notifications"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "WikiMasters Doublons", "default_icon": { "128": "icone-128.png" } },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": [
        "https://www.wiki-masters.com/*",
        "https://wiki-masters.com/*"
      ],
      "js": ["commun.js", "content.js"],
      "css": ["style.css"]
    }
  ]
}
